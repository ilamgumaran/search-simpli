          "op": "apply_changes",
          "changes": [
            {
              "op": "pending",
              "root_id": "home",
              "path": "inbox/late-arrival.md",
              "size": 5000
            }
          ],
          "expect_report": {
            "pending": 1
          }
        },
        {
          "op": "index_status",
          "expect": {
            "pending_paths": [
              {
                "root_id": "home",
                "path": "inbox/late-arrival.md"
              }
            ]
          }
        },
        {
          "op": "apply_changes",
          "changes": [
