{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/search-tool.schema.json",
  "title": "SearchKnowledgeResult",
  "type": "object",
  "required": [
    "tool",
    "query",
    "index",
    "retrieval",
    "results",
    "answer_policy"
  ],
  "properties": {
    "tool": {
      "const": "search_knowledge"
    },
    "query": {
      "type": "string"
    },
    "index": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "root": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "analyzer_id": {
          "type": "string"
        },
        "embedding_model_id": {
          "type": "string"
        }
      }
    },
    "retrieval": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "lexical",
            "vector",
            "hybrid"
          ]
        },
        "vector_mode": {
          "type": "string"
        },
        "vector_dimensions": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_k": {
          "type": "integer",
          "minimum": 1
        },
        "embedding": {
          "type": [
            "object",
            "null"
          ]
        },
        "authorization": {
          "type": "object",
          "required": [
            "semantics",
            "principal_label_count"
          ],
          "properties": {
            "semantics": {
              "const": "all-required-labels-v1"
            },
            "principal_label_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "search_field": {
          "enum": [
            "content",
            "filename",
            "both"
          ],
          "description": "Search field. both (since 2.3.0) is a score-level merge, one result per file: the file's best body chunk's BM25 plus its title part; candidate_k is validated but does not cut it."
        },
        "filename_policy_id": {
          "const": "filename-field-v1"
        },
        "title_policy_id": {
          "const": "title-field-v1",
          "description": "Title policy id (contract 2.3.0): present whenever the lexical channel ran under content or both. A file's folder names and file stem (title-field-v1, docs/title-field-v1.md) add a BM25 part to its best chunk."
        },
        "fuzzy_policy_id": {
          "const": "fuzzy-v1",
          "description": "Fuzzy policy id (contract 2.4.0): present whenever the lexical channel ran under content or both. A query word of 5 or more Latin code points that no chunk in scope and no visible file's name holds is also searched as up to 3 dictionary words within 1 edit (5 code points) or 2 edits (6 or more) sharing its first letter (fuzzy-v1, docs/fuzzy-v1.md)."
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chunk_id",
          "citation",
          "content",
          "score",
          "ranking"
        ],
        "properties": {
          "chunk_id": {
            "type": "string"
          },
          "citation": {
            "type": "object",
            "required": [
              "path",
              "start_line",
              "end_line"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "content": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "ranking": {
            "type": "object"
          },
          "matched_in": {
            "type": "array",
            "items": {
              "enum": [
                "content",
                "filename"
              ]
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "basename": {
            "type": "string",
            "minLength": 1
          },
          "match_sections": {
            "type": "object",
            "required": [
              "filename",
              "content"
            ],
            "properties": {
              "filename": {
                "type": "object",
                "required": [
                  "label",
                  "matched",
                  "matched_terms",
                  "text",
                  "citation"
                ],
                "properties": {
                  "label": {
                    "const": "File name"
                  },
                  "matched": {
                    "type": "boolean"
                  },
                  "matched_terms": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  },
                  "text": {
                    "type": "string"
                  },
                  "citation": {
                    "type": "object",
                    "required": [
                      "path",
                      "field"
                    ],
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "field": {
                        "const": "filename"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "content": {
                "type": "object",
                "required": [
                  "label",
                  "matched",
                  "matched_terms",
                  "text",
                  "citation"
                ],
                "properties": {
                  "label": {
                    "const": "Content"
                  },
                  "matched": {
                    "type": "boolean"
                  },
                  "matched_terms": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  },
                  "text": {
                    "type": "string"
                  },
                  "citation": {
                    "type": "object",
                    "required": [
                      "path",
                      "field",
                      "start_line",
                      "end_line"
                    ],
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "field": {
                        "const": "content"
                      },
                      "start_line": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "end_line": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "additionalProperties": false
                  }
                }
              }
            },
            "additionalProperties": false,
            "description": "Two source-specific views in filename/both results. matched and matched_terms describe analyzed terms actually in each displayed source, independently of which candidate channel contributed to ranking."
          }
        }
      }
    },
    "answer_policy": {
      "type": "object",
      "required": [
        "ground_in_results",
        "cite_path_and_lines",
        "say_when_evidence_is_insufficient"
      ],
      "properties": {
        "ground_in_results": {
          "const": true
        },
        "cite_path_and_lines": {
          "const": true
        },
        "say_when_evidence_is_insufficient": {
          "const": true
        },
        "filename_matches_are_navigation": {
          "const": true
        }
      }
    },
    "warnings": {
      "description": "Contract 1.2.0, ss_query only: why a result list is empty or poor. Always present (possibly empty) in an ss_query report; absent from JSON-RPC search_knowledge results. Query-term warnings are only produced in lexical and hybrid retrieval, where the terms are used.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "enum": [
              "query_term_unmatched",
              "query_term_expanded",
              "query_empty_after_analysis",
              "vector_ignored",
              "candidate_depth_cut"
            ]
          },
          "message": {
            "type": "string"
          },
          "term": {
            "description": "The analysed query term (query_term_unmatched and query_term_expanded), never the index's spelling. One query_term_unmatched warning per distinct term, in query order; since 2.4.0 a query_term_expanded warning follows it when fuzzy-v1 also searched other words for it.",
            "type": "string"
          },
          "expansions": {
            "description": "Contract 2.4.0, query_term_expanded only: the dictionary words also searched for term, best first (fewest edits, then the most chunks in scope, then bytes); never a word only hidden chunks or files hold.",
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 3
          }
        },
        "additionalProperties": false
      }
    },
    "request": {
      "description": "Contract 1.2.0, ss_query only: the request as the engine used it (defaults filled in).",
      "type": "object",
      "required": [
        "analyzer_id",
        "retrieval_mode",
        "top_k",
        "candidate_k",
        "path_prefix"
      ],
      "properties": {
        "analyzer_id": {
          "type": "string"
        },
        "retrieval_mode": {
          "enum": [
            "lexical",
            "vector",
            "hybrid"
          ]
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "candidate_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "path_prefix": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "description": "Contract 1.2.0, ss_query only, present only when options_json has \"profile\": true. Microseconds on a monotonic clock. serialize_us covers the report up to this field.",
      "type": "object",
      "required": [
        "tokenize_us",
        "score_us",
        "rank_us",
        "serialize_us",
        "matched_chunks"
      ],
      "properties": {
        "tokenize_us": {
          "type": "integer",
          "minimum": 0
        },
        "score_us": {
          "type": "integer",
          "minimum": 0
        },
        "rank_us": {
          "type": "integer",
          "minimum": 0
        },
        "serialize_us": {
          "type": "integer",
          "minimum": 0
        },
        "matched_chunks": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
