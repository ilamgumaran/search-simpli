{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/search-tool.schema.json",
  "title": "SearchKnowledgeResult",
  "type": "object",
  "required": ["tool", "query", "index", "retrieval", "results", "answer_policy"],
  "properties": {
    "tool": { "const": "search_knowledge" },
    "query": { "type": "string" },
    "index": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "root": { "type": "string" },
        "version": { "type": "integer" },
        "generation": { "type": "integer", "minimum": 1 },
        "analyzer_id": { "type": "string" },
        "embedding_model_id": { "type": "string" }
      }
    },
    "retrieval": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["lexical", "vector", "hybrid"] },
        "vector_mode": { "type": "string" },
        "vector_dimensions": { "type": "integer", "minimum": 0 },
        "candidate_k": { "type": "integer", "minimum": 1 },
        "embedding": { "type": ["object", "null"] },
        "authorization": {
          "type": "object",
          "required": ["semantics", "principal_label_count"],
          "properties": {
            "semantics": { "const": "all-required-labels-v1" },
            "principal_label_count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chunk_id", "citation", "content", "score", "ranking"],
        "properties": {
          "chunk_id": { "type": "string" },
          "citation": {
            "type": "object",
            "required": ["path", "start_line", "end_line"],
            "properties": {
              "path": { "type": "string" },
              "start_line": { "type": "integer", "minimum": 1 },
              "end_line": { "type": "integer", "minimum": 1 }
            }
          },
          "content": { "type": "string" },
          "score": { "type": "number" },
          "ranking": { "type": "object" }
        }
      }
    },
    "answer_policy": {
      "type": "object",
      "required": ["ground_in_results", "cite_path_and_lines", "say_when_evidence_is_insufficient"],
      "properties": {
        "ground_in_results": { "const": true },
        "cite_path_and_lines": { "const": true },
        "say_when_evidence_is_insufficient": { "const": true }
      }
    },
    "warnings": {
      "description": "Contract 1.2.0, ss_query only: why a result list is empty or poor. Always present (possibly empty) in an ss_query report; absent from JSON-RPC search_knowledge results. Query-term warnings are only produced in lexical and hybrid retrieval, where the terms are used.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "enum": [
              "query_term_unmatched",
              "query_empty_after_analysis",
              "vector_ignored",
              "candidate_depth_cut"
            ]
          },
          "message": { "type": "string" },
          "term": {
            "description": "The analysed query term (query_term_unmatched only).",
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "request": {
      "description": "Contract 1.2.0, ss_query only: the request as the engine used it (defaults filled in).",
      "type": "object",
      "required": ["analyzer_id", "retrieval_mode", "top_k", "candidate_k", "path_prefix"],
      "properties": {
        "analyzer_id": { "type": "string" },
        "retrieval_mode": { "enum": ["lexical", "vector", "hybrid"] },
        "top_k": { "type": "integer", "minimum": 1, "maximum": 100 },
        "candidate_k": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "path_prefix": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "profile": {
      "description": "Contract 1.2.0, ss_query only, present only when options_json has \"profile\": true. Microseconds on a monotonic clock. serialize_us covers the report up to this field.",
      "type": "object",
      "required": ["tokenize_us", "score_us", "rank_us", "serialize_us", "matched_chunks"],
      "properties": {
        "tokenize_us": { "type": "integer", "minimum": 0 },
        "score_us": { "type": "integer", "minimum": 0 },
        "rank_us": { "type": "integer", "minimum": 0 },
        "serialize_us": { "type": "integer", "minimum": 0 },
        "matched_chunks": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
