{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/tools/read_span.result.schema.json",
  "title": "read_span result",
  "description": "A line range.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "description": "The request echoed with defaults filled in (roots is null when not given).",
      "properties": {
        "root_id": {
          "type": "string",
          "description": "Root id."
        },
        "path": {
          "type": "string",
          "description": "Path."
        },
        "start_line": {
          "type": "integer",
          "description": "Start.",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "description": "End.",
          "minimum": 1
        },
        "context_lines": {
          "type": "integer",
          "description": "Context.",
          "minimum": 0,
          "maximum": 20
        },
        "roots": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Root ids to search. Narrows the server's roots, never widens them; absent or null means every root the server allows."
        }
      },
      "additionalProperties": false,
      "required": [
        "root_id",
        "path",
        "start_line",
        "end_line",
        "context_lines",
        "roots"
      ]
    },
    "generation": {
      "type": "integer",
      "description": "The index generation this answer came from.",
      "minimum": 0
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "warnings": {
      "type": "array",
      "description": "Warnings about this answer.",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "start_line": {
      "type": "integer",
      "description": "First line returned.",
      "minimum": 1
    },
    "end_line": {
      "type": "integer",
      "description": "Last line returned (clamped).",
      "minimum": 1
    },
    "text": {
      "type": "string",
      "description": "The original bytes of the span, line terminators included."
    },
    "context_before": {
      "type": "string",
      "description": "Context lines before the span."
    },
    "context_after": {
      "type": "string",
      "description": "Context lines after the span."
    },
    "byte_exact": {
      "const": true,
      "description": "Always true: text is the retained bytes."
    },
    "sha256": {
      "type": "string",
      "description": "SHA-256 of text, 64 hex digits.",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "required": [
    "request",
    "generation",
    "scope",
    "warnings",
    "start_line",
    "end_line",
    "text",
    "context_before",
    "context_after",
    "byte_exact",
    "sha256"
  ],
  "$defs": {
    "scope": {
      "type": "object",
      "description": "The scope the request ran in.",
      "properties": {
        "roots": {
          "type": "array",
          "description": "The root ids the request could see, in the generation's order.",
          "items": {
            "type": "string"
          }
        },
        "labels_applied": {
          "const": true,
          "description": "Always true: the scope's labels (possibly none) filtered before any candidate. It does not say whether labels hid anything."
        }
      },
      "additionalProperties": false,
      "required": [
        "roots",
        "labels_applied"
      ]
    },
    "warning": {
      "type": "object",
      "description": "One warning.",
      "properties": {
        "code": {
          "type": "string",
          "description": "Machine-readable code. So far `end_line_clamped` (read_span)."
        },
        "message": {
          "type": "string",
          "description": "Human-readable detail."
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    }
  }
}
