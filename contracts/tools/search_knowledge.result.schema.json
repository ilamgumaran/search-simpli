{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/tools/search_knowledge.result.schema.json",
  "title": "search_knowledge result",
  "description": "The shared evidence envelope: ranked chunks with citations. Since S3-T6 each item names its root_id and section_path, and the result carries truncated and pending_files over the same scope (the v1 fields are unchanged). No `empty` flag: an empty results list is not proof of absence.",
  "type": "object",
  "properties": {
    "tool": {
      "const": "search_knowledge",
      "description": "Always search_knowledge."
    },
    "query": {
      "type": "string",
      "description": "The query as received."
    },
    "index": {
      "type": "object",
      "description": "The index that answered.",
      "properties": {
        "version": {
          "type": "integer",
          "description": "Index format version."
        },
        "generation": {
          "type": "integer",
          "description": "Index generation.",
          "minimum": 1
        },
        "analyzer_id": {
          "type": "string",
          "description": "Analyzer identifier."
        },
        "embedding_model_id": {
          "type": "string",
          "description": "Embedding model id, or none."
        }
      },
      "additionalProperties": false,
      "required": [
        "version"
      ]
    },
    "retrieval": {
      "type": "object",
      "description": "How the retrieval ran.",
      "properties": {
        "mode": {
          "enum": [
            "lexical",
            "vector",
            "hybrid"
          ],
          "description": "Retrieval mode used."
        },
        "vector_mode": {
          "type": "string",
          "description": "Vector mode, when the index has vectors."
        },
        "vector_dimensions": {
          "type": "integer",
          "description": "Vector dimensions, 0 without vectors.",
          "minimum": 0
        },
        "candidate_k": {
          "type": "integer",
          "minimum": 1,
          "description": "Candidate k."
        },
        "embedding": {
          "type": [
            "object",
            "null"
          ],
          "description": "Embedding provider details, when used."
        },
        "authorization": {
          "type": "object",
          "description": "Authorization applied.",
          "properties": {
            "semantics": {
              "const": "all-required-labels-v1",
              "description": "Label rule."
            },
            "principal_label_count": {
              "type": "integer",
              "description": "Number of principal labels applied.",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "semantics",
            "principal_label_count"
          ]
        },
        "search_field": {
          "enum": [
            "content",
            "filename",
            "both"
          ],
          "description": "Search field."
        },
        "filename_policy_id": {
          "const": "filename-field-v1",
          "description": "Filename policy id."
        }
      },
      "additionalProperties": false,
      "required": [
        "mode"
      ]
    },
    "results": {
      "type": "array",
      "description": "Ranked chunks, best first. Empty is not proof of absence.",
      "items": {
        "type": "object",
        "description": "One ranked chunk.",
        "properties": {
          "chunk_id": {
            "type": "string",
            "description": "Stable chunk id; pass it to read_chunk."
          },
          "citation": {
            "type": "object",
            "description": "Where the chunk lives.",
            "properties": {
              "path": {
                "type": "string",
                "description": "Record path: `root_id/path` for a host root."
              },
              "start_line": {
                "type": "integer",
                "description": "First line, 1-based.",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "description": "Last line, inclusive.",
                "minimum": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "path",
              "start_line",
              "end_line"
            ]
          },
          "content": {
            "type": "string",
            "description": "The chunk text."
          },
          "score": {
            "type": "number",
            "description": "Fused score."
          },
          "ranking": {
            "type": "object",
            "description": "Per-channel ranks and scores.",
            "properties": {
              "lexical": {
                "type": "object",
                "description": "Lexical channel.",
                "properties": {
                  "rank": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Rank, null if not ranked.",
                    "minimum": 1
                  },
                  "score": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Score."
                  }
                },
                "additionalProperties": false,
                "required": [
                  "rank",
                  "score"
                ]
              },
              "vector": {
                "type": "object",
                "description": "Vector channel.",
                "properties": {
                  "rank": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Rank, null if not ranked.",
                    "minimum": 1
                  },
                  "score": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Score."
                  },
                  "mode": {
                    "type": "string",
                    "description": "Vector mode."
                  }
                },
                "additionalProperties": false,
                "required": [
                  "rank",
                  "score"
                ]
              },
              "filename": {
                "type": "object",
                "description": "Filename-field lexical score and rank, when that field is requested.",
                "properties": {
                  "rank": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Rank, null if not ranked.",
                    "minimum": 1
                  },
                  "score": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Score."
                  }
                },
                "additionalProperties": false,
                "required": [
                  "rank",
                  "score"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "lexical",
              "vector"
            ]
          },
          "root_id": {
            "type": "string",
            "description": "Root id of the chunk's file (S3-T6); the citation path is `root_id/path` for a host root."
          },
          "section_path": {
            "type": "array",
            "description": "Heading path of the chunk's section, [] for a file without headings (S3-T6).",
            "items": {
              "type": "string"
            }
          },
          "matched_in": {
            "type": "array",
            "items": {
              "enum": [
                "content",
                "filename"
              ]
            },
            "uniqueItems": true,
            "minItems": 1,
            "description": "Matched in."
          },
          "basename": {
            "type": "string",
            "minLength": 1,
            "description": "Basename."
          },
          "match_sections": {
            "type": "object",
            "required": [
              "filename",
              "content"
            ],
            "properties": {
              "filename": {
                "type": "object",
                "required": [
                  "label",
                  "matched",
                  "matched_terms",
                  "text",
                  "citation"
                ],
                "properties": {
                  "label": {
                    "const": "File name",
                    "description": "Label."
                  },
                  "matched": {
                    "type": "boolean",
                    "description": "Matched."
                  },
                  "matched_terms": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true,
                    "description": "Matched terms."
                  },
                  "text": {
                    "type": "string",
                    "description": "Text."
                  },
                  "citation": {
                    "type": "object",
                    "required": [
                      "path",
                      "field"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "description": "Path."
                      },
                      "field": {
                        "const": "filename",
                        "description": "Field."
                      }
                    },
                    "additionalProperties": false,
                    "description": "Citation."
                  }
                },
                "description": "Filename.",
                "additionalProperties": false
              },
              "content": {
                "type": "object",
                "required": [
                  "label",
                  "matched",
                  "matched_terms",
                  "text",
                  "citation"
                ],
                "properties": {
                  "label": {
                    "const": "Content",
                    "description": "Label."
                  },
                  "matched": {
                    "type": "boolean",
                    "description": "Matched."
                  },
                  "matched_terms": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true,
                    "description": "Matched terms."
                  },
                  "text": {
                    "type": "string",
                    "description": "Text."
                  },
                  "citation": {
                    "type": "object",
                    "required": [
                      "path",
                      "field",
                      "start_line",
                      "end_line"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "description": "Path."
                      },
                      "field": {
                        "const": "content",
                        "description": "Field."
                      },
                      "start_line": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Start line."
                      },
                      "end_line": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "End line."
                      }
                    },
                    "additionalProperties": false,
                    "description": "Citation."
                  }
                },
                "description": "Content.",
                "additionalProperties": false
              }
            },
            "additionalProperties": false,
            "description": "Two source-specific views in filename/both results. matched and matched_terms describe analyzed terms actually in each displayed source, independently of which candidate channel contributed to ranking."
          }
        },
        "additionalProperties": false,
        "required": [
          "chunk_id",
          "citation",
          "content",
          "score",
          "ranking",
          "root_id",
          "section_path"
        ]
      }
    },
    "answer_policy": {
      "type": "object",
      "description": "The policy the answer must follow.",
      "properties": {
        "ground_in_results": {
          "const": true,
          "description": "Ground every claim in results."
        },
        "cite_path_and_lines": {
          "const": true,
          "description": "Cite path and lines."
        },
        "say_when_evidence_is_insufficient": {
          "const": true,
          "description": "Say when evidence is insufficient."
        },
        "filename_matches_are_navigation": {
          "const": true,
          "description": "Filename matches help navigation; the cited body is evidence."
        }
      },
      "additionalProperties": false,
      "required": [
        "ground_in_results",
        "cite_path_and_lines",
        "say_when_evidence_is_insufficient"
      ]
    },
    "warnings": {
      "type": "array",
      "description": "Why a result list is empty or poor (when present).",
      "items": {
        "type": "object",
        "description": "One warning.",
        "properties": {
          "code": {
            "type": "string",
            "description": "Warning code."
          },
          "message": {
            "type": "string",
            "description": "Detail."
          },
          "term": {
            "type": "string",
            "description": "The analysed query term, when relevant."
          }
        },
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ]
      }
    },
    "truncated": {
      "type": "boolean",
      "description": "True when a file in scope was given to the engine but not indexed in full (too large, unreadable or over a run's byte budget): the corpus may be incomplete (S3-T6)."
    },
    "pending_files": {
      "type": "integer",
      "description": "Files in scope still waiting for their bytes; the corpus may be incomplete when above 0 (S3-T6).",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "tool",
    "query",
    "index",
    "retrieval",
    "results",
    "answer_policy",
    "truncated",
    "pending_files"
  ]
}
