 /// (`lexical_segment.validatePositions`) of one document's table
 /// (`offsets[at_start..end]`, `count` tokens), for a table the first publish
 /// drops rather than transcodes: `InvalidPositions` where v2 refuses it.
+/// verifier plant reader
+fn vpSix(bytes: []const u8, offset: *usize) ?u32 {
+    var value: u64 = 0;
+    var shift: u6 = 0;
+    var at = offset.*;
+    while (true) {
+        if (at >= bytes.len or shift > 35) return null;
+        const byte = bytes[at];
+        at += 1;
+        value |= @as(u64, byte & 0x7F) << shift;
+        if (byte & 0x80 == 0) break;
+        shift += 7;
+    }
+    if (value > std.math.maxInt(u32)) return null;
+    offset.* = at;
+    return @intCast(value);
+}
