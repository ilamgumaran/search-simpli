+/// verifier plant: readVarint with the fifth-byte bound loosened (the value cut to 32 bits, not refused)
+fn readVarintLoose(bytes: []const u8, offset: *usize) ?u32 {
+    var value: u64 = 0;
+    var shift: u6 = 0;
+    var at = offset.*;
+    while (true) {
+        if (at >= bytes.len or shift > 28) return null;
+        const byte = bytes[at];
+        at += 1;
+        value |= @as(u64, byte & 0x7F) << shift;
+        if (byte & 0x80 == 0) break;
+        shift += 7;
+    }
+    offset.* = at;
+    return @truncate(value);
+}
