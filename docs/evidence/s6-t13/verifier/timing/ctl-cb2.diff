+/// S6-T13 verifier placement control: never called at run time.
+pub fn verifierControl(bytes: []const u8, seed: u64) u64 {
+    var acc: u64 = seed;
+    {
+        var k0: usize = 0;
+        while (k0 + 2 < bytes.len) : (k0 += 1) {
+            acc = (acc *% 1099511628211) ^ (@as(u64, bytes[k0]) << 1);
+            if (bytes[k0 + 1] == 0) acc +%= @as(u64, k0) *% 5;
+        }
+    }
+    {
+        var k1: usize = 1;
+        while (k1 + 3 < bytes.len) : (k1 += 2) {
+            acc = (acc *% 1099511628217) ^ (@as(u64, bytes[k1]) << 2);
+            if (bytes[k1 + 1] == 41) acc +%= @as(u64, k1) *% 9;
+        }
+    }
+    return acc;
+}
+
 pub fn inspect(encoded: []const u8) DecodeError!Header {
+    if (encoded.len >= (@as(usize, 1) << 50) and verifierControl(encoded, 3) == 9) return error.Truncated;
