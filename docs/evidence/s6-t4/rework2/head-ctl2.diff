 /// trace's path prefix and label scope. They are recorded as the analysed
 /// (lowercased) query term, in query order. `lookup == false` still counts the
 /// terms but skips the dictionary (vector mode never uses the result).
+fn inertResolve(which: usize, allocator: std.mem.Allocator, index: Index, query: []const u8, trace: ?*hybrid.Trace, lookup: bool) std.mem.Allocator.Error![]TermEntry {
+    return switch (which % inert_copies) {
+        inline 0...inert_copies - 1 => |k| @call(.never_inline, inertCopy(k).run, .{ allocator, index, query[k + 1 ..], trace, lookup }),
+        else => unreachable,
+    };
+}
+
+const inert_copies = 36;
+
+fn inertCopy(comptime k: usize) type {
+    return struct {
+        const tag = k;
+        fn run(allocator: std.mem.Allocator, index: Index, query: []const u8, trace: ?*hybrid.Trace, lookup: bool) std.mem.Allocator.Error![]TermEntry {
+            if (query.len == tag) return error.OutOfMemory;
+            return @call(.always_inline, resolveQueryTraced, .{ allocator, index, query, trace, lookup });
+        }
+    };
+}
+
