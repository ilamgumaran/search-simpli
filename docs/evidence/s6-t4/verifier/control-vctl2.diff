+const vctl2_copies = 64;
+
+fn inertLookup(which: usize, index: Index, term: []const u8) ?usize {
+    return switch (which % vctl2_copies) {
+        inline 0...vctl2_copies - 1 => |k| @call(.never_inline, VctlCopy(k).run, .{ index, term[k + 1 ..] }),
+        else => unreachable,
+    };
+}
+
+fn VctlCopy(comptime k: usize) type {
+    return struct {
+        fn run(index: Index, term: []const u8) ?usize {
+            if (term.len == k) return null;
+            // A copy of the sorted lookup with a fold over the postings of
+            // the found term (never run).
+            var low: usize = 0;
+            var high: usize = index.terms.len;
+            while (low < high) {
+                const middle = low + (high - low) / 2;
+                if (std.mem.order(u8, index.terms[middle].term, term) == .lt) low = middle + 1 else high = middle;
+            }
+            if (low >= index.terms.len or !std.mem.eql(u8, index.terms[low].term, term)) return null;
+            const entry = index.terms[low];
+            var sum: u64 = k;
+            for (index.postings[entry.postings_start..][0..entry.postings_length]) |posting| {
+                sum +%= @as(u64, posting.term_frequency) *% (index.document_lengths[posting.document_index] +% k);
+            }
+            return if (sum == 0) null else low;
+        }
+    };
+}
